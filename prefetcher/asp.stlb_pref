#include "cache.h"
 
// ------------------------- DO NOT CHANGE -------------------------------- //
#define IP_TRACKER_COUNT 64           // Number of IP trackers
// ------------------------- DO NOT CHANGE -------------------------------- //
 
#define PREFETCH_DEGREE 10            // Prefetch degree - you need to vary this!
 
class IP_TRACKER {
    private:
        uint64_t ip_value;
        uint64_t page_addr_prev,page_addr_recent;
        uint8_t state; //0 1st acess
        int16_t stride; // max posible stride is 63
    public:
        uint8_t lru; 
        // ------------------------- Define the IP_TRACKER class here ------------------------- //
        
        void initialise_ip(uint64_t ip, uint64_t addr){
            state=0;
            ip_value= ip;
            page_addr_recent= addr;
            stride=0;
        }
 
        uint64_t set_page_addr_recent(uint64_t addr){
            page_addr_prev = page_addr_recent;
            page_addr_recent = addr;
            int64_t temp_stride ;
            temp_stride = page_addr_recent-page_addr_prev;
 
            if (state == 3 && stride == temp_stride) {
                return stride;
            }
 
            if (state && stride && (stride == temp_stride)) {
                if (state == 2) {
                    state = 3;
                }
                return stride;
            }
 
            if (state == 2) {
                stride = temp_stride;
                state = 1; 
            } else if (state == 1) {
                stride = temp_stride;
                state = 2; 
            } else {
                stride = temp_stride;
                state = 1; 
            }
 
            return -1;  
 
        }
 
        uint64_t get_ip (){
            return ip_value;
        }
 
        uint64_t get_mr_addr(){
            return page_addr_recent;
        }
 
        uint8_t get_stride(){
            return stride;
        }
 
    
 
};
 
IP_TRACKER trackers[IP_TRACKER_COUNT];
 
 
// ------------------------- Initialize the prefetcher ------------------------- // 
void CACHE::stlb_prefetcher_initialize() 
{
    cout << "CPU " << cpu << " STLB arbitrary stride prefetcher" << endl;
    for(int i=0; i<IP_TRACKER_COUNT; i++)
        trackers[i].lru = i;
 
}
 
// --------------- This is the main prefetcher opeate function ---------------- // 
void CACHE::stlb_prefetcher_operate(uint64_t addr  , uint64_t ip, uint8_t cache_hit, uint8_t type, uint64_t prefetch_id, uint8_t instruction)
{
    // ------------------------ Add Arbitrary Stride pf_address logic here ----------------------- // 
 
    uint64_t page_addr= addr >> LOG2_PAGE_SIZE;
    int tracker_index = -1;
 
    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[i].get_ip() == ip) {
            tracker_index = i;
            break;
        }
    }
 
    if (tracker_index == -1) {
        for (int k = 0; k < IP_TRACKER_COUNT; k++) {
            if (trackers[k].lru == (IP_TRACKER_COUNT - 1)) {
                trackers[k].initialise_ip(ip, page_addr);
                tracker_index = k;
                break;
            }
        }
 
        for (int j = 0; j < IP_TRACKER_COUNT; j++) {
            if (trackers[j].lru < trackers[tracker_index].lru) {
                trackers[j].lru++;
            }
        }
    trackers[tracker_index].lru = 0;
    return;
    }
 
    int32_t stride = trackers[tracker_index].set_page_addr_recent(page_addr);
    
    if(stride != -1){
       for(int i =2 ; i <= PREFETCH_DEGREE+1;i++){
            uint64_t pf_address = (page_addr+stride*i)<<LOG2_PAGE_SIZE;
            // if(pf_address>>LOG2_PAGE_SIZE != addr>> LOG2_PAGE_SIZE)        
                prefetch_translation(ip, pf_address, (int)2, 0, prefetch_id, instruction);
        // }
        }
    }
     for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[tracker_index].lru) {
            trackers[i].lru++;
        }
    }
    trackers[tracker_index].lru = 0;
}
 
// ------------------------- DO NOT CHANGE -------------------------------- //
void CACHE::stlb_prefetcher_cache_fill(uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}
 
void CACHE::stlb_prefetcher_final_stats()
{
    cout << "CPU " << cpu << " STLB arbitrary stride prefetcher final stats" << endl;
    cout << "Degree: " << PREFETCH_DEGREE << endl;
}
