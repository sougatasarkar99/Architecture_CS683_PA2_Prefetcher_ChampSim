#include "cache.h"
#include <unordered_map>

// ------------------------- DO NOT CHANGE -------------------------------- //
#define NUM_IP_TABLE_ENTRIES 1024           // IP table entries
#define PREFETCH_DEGREE 5                   // Prefetch degree
#define NUM_SIG_BITS 7
// ------------------------- DO NOT CHANGE -------------------------------- //
unordered_map<uint64_t,pair<uint16_t,uint64_t>> ip_sig_table;       //ip mapped with its past signature and last cl_addr
// ------------ YOU CAN CHANGE THE IP_TABLE FOR YOU DESIGN ---------------- //
class IP_TABLE {
  public:
    uint64_t ip;
    uint64_t last_page;                     // last page seen by IP
    uint64_t cl_addr;                // last cl offset in the 4KB page
//    int64_t last_stride;                    // last delta observed
    uint16_t ip_valid;                      // Valid IP or not   
    int conf;                               // CPLX conf
    uint16_t signature;                     // CPLX signature
    int stride;                             // Stride
    int lru;

    IP_TABLE () {
        ip = 0;
        last_page = 0;
        cl_addr = 0;
//        last_stride = 0;
        ip_valid = 0;
        signature = 0;
        conf = 0;
        stride = 0;
        lru = 0;
    };

    void initialise(uint64_t ips , uint64_t addr){
        ip = ips;
        cl_addr = addr >> LOG2_BLOCK_SIZE;
        last_page = addr >> LOG2_PAGE_SIZE; 
 //       last_stride = 0;
        ip_valid = 1;
        signature = 0;
        conf = 0;
        stride = 0;
        ip_sig_table[ip].first = 0;
        ip_sig_table[ip].second = cl_addr;
    }

    void add_signature(uint64_t ips , uint64_t addr){
        ip=ips;
        cl_addr = addr >> LOG2_BLOCK_SIZE;
        last_page = addr >> LOG2_PAGE_SIZE; 
 //       last_stride = 0;
        ip_valid = 1;
        signature = ip_sig_table[ip].first;
        conf = 0;
        //stride = cl_addr - ;
        if (cl_addr > ip_sig_table[ip].second)
                stride = cl_addr - ip_sig_table[ip].second;
            else {
                stride = ip_sig_table[ip].second - cl_addr;
                stride *= -1;
            }
        ip_sig_table[ip].second = cl_addr;
    }
};

IP_TABLE trackers_cplx[NUM_CPUS][NUM_IP_TABLE_ENTRIES];

// ------------------------- Updating the signature ---------------------------- // 
uint16_t update_sig_l1(uint16_t old_sig, int delta) {                           
    uint16_t new_sig = 0;
    int sig_stride = 0;
    if(delta < 0){
        sig_stride = (-1) * delta + (1 << (NUM_SIG_BITS-1));
    }
    else 
        sig_stride = delta;

    new_sig = ((old_sig << 1) ^ sig_stride) & ((1 << NUM_SIG_BITS)-1); 
    return new_sig;
}

// ------------------- Updating confidence for the CPLX class ------------------ // 
int update_conf(int stride, int prev_stride, int conf) {
    if(prev_stride == stride )
        if(conf != 3)
            conf++;
        else ;
    else
        if(conf > 0)
            conf --;

    return conf;
}

// ------------------------- Initialize the prefetcher ------------------------- // 
void CACHE::l1d_prefetcher_initialize() 
{
    cout << "CPU " << cpu << " L1D Complex-Stride prefetcher" << endl;
    for(int i = 0; i< NUM_IP_TABLE_ENTRIES; i++){
        trackers_cplx[0][i].lru = i ;
    }
    
}

// --------------- This is the main prefetcher operate function ---------------- // 
void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    int i;
    bool ip_found = false;

	// --------------------- Add Complex-Stride pf_address logic here --------------------- // 
    for(i = 0 ; i<NUM_IP_TABLE_ENTRIES ; i++){
        uint64_t stride = 0;
        if(trackers_cplx[0][i].ip == ip){
            ip_found =true;
            //calculate stride
            if (cl_addr > trackers_cplx[0][i].cl_addr)
                stride = cl_addr - trackers_cplx[0][i].cl_addr;
            else {
                stride = trackers_cplx[0][i].cl_addr - cl_addr;
                stride *= -1;
            }
            if(stride == 0)
                return;       //try with continue

            if(trackers_cplx[0][i].signature == ip_sig_table[ip].first){        //check signature
                trackers_cplx[0][i].conf = update_conf(stride ,trackers_cplx[0][i].stride,trackers_cplx[0][i].conf );   //updateing conf
                if(trackers_cplx[0][i].conf == 0)
                    trackers_cplx[0][i].stride = stride;        //changing stride if conf is zero
                else if(trackers_cplx[0][i].conf>1){
                     for(int j =2 ; j <= PREFETCH_DEGREE+1 ;j++){       //prefetching by #degree
                            uint64_t pf_address = (cl_addr+trackers_cplx[0][i].stride*j)<<LOG2_BLOCK_SIZE;
                            prefetch_line(ip, addr, pf_address, FILL_L1, 0);
                        }
                    
                    // paper logic , couldnt implement it time

                    // int signature = ip_sig_table[ip].first;
                    // uint64_t pf_address = (cl_addr+trackers_cplx[0][i].stride)<<LOG2_BLOCK_SIZE;
                    // prefetch_line(ip, addr, pf_address, FILL_L1, 0);
                    // for(int j = 1 ; j < PREFETCH_DEGREE ; j++){
                        
                    //     signature = update_sig_l1(signature , stride);
                    //     IP_TABLE temp ;
                    //     bool found = false;
                    //     for(int i=0; i<NUM_IP_TABLE_ENTRIES ; i++){
                    //         if(trackers_cplx[cpu][i].ip == ip){
                    //             if(trackers_cplx[0][i].signature == signature){
                    //                 temp = trackers_cplx[0][i];
                    //                 break;
                    //                 found = true;
                    //             }
                    //         } 
                    //     }
                    //     signature = update_sig_l1(signature , stride);
                    //     if(found){
                    //         uint64_t pf_address = (temp.cl_addr+temp.stride)<<LOG2_BLOCK_SIZE;
                    //         prefetch_line(ip, addr, pf_address, FILL_L1, 0);
                    //     }
                            
                }




                //set_LRU
                for(int j = 0 ; j < NUM_IP_TABLE_ENTRIES ; j++)
                    if(trackers_cplx[0][j].lru < trackers_cplx[0][i].lru)
                        trackers_cplx[0][j].lru++; // if(stride == 0)
                trackers_cplx[0][i].lru = 0;


                ip_sig_table[ip].first = update_sig_l1(trackers_cplx[0][i].signature , stride); //update signature
                trackers_cplx[0][i].signature = ip_sig_table[ip].first;
                ip_sig_table[ip].second = cl_addr;
                trackers_cplx[0][i].cl_addr = cl_addr;      //update signature for IP table entry
                
                return;
            }
            else{       //if signature not match
                continue;
            }
                
        }

    }
    //add entry for ip seen first time
    if(i == NUM_IP_TABLE_ENTRIES && !ip_found){ 
        //cout<<"\n IP not found in table: "<<ip;   
        int k;
        for(k=0 ;k < NUM_IP_TABLE_ENTRIES ; k++){
            if(trackers_cplx[0][k].lru == NUM_IP_TABLE_ENTRIES -1)
                break;
        }

        trackers_cplx[0][k].initialise(ip,addr);
        for(int j = 0 ; j < NUM_IP_TABLE_ENTRIES ; j++)
            if(trackers_cplx[0][j].lru < trackers_cplx[0][k].lru)
                trackers_cplx[0][j].lru++;

        trackers_cplx[0][k].lru = 0;
    }

    //add entry of new signature of existing ip
    else if(i == NUM_IP_TABLE_ENTRIES && ip_found){
        //cout<<"\nIP found but new signature :"<<ip;
        int k;
        for(k=0 ;k < NUM_IP_TABLE_ENTRIES ; k++){
            if(trackers_cplx[0][k].lru == NUM_IP_TABLE_ENTRIES -1)
                break;
        }

        trackers_cplx[0][k].add_signature(ip,addr);
        for(int j = 0 ; j < NUM_IP_TABLE_ENTRIES ; j++)
            if(trackers_cplx[0][j].lru < trackers_cplx[0][k].lru)
                trackers_cplx[0][j].lru++;

        trackers_cplx[0][k].lru = 0;
    }
    else{
        perror("Unhandled case!");
        exit(EXIT_FAILURE);
    }


	// prefetch_line(ip, addr, pf_address, FILL_L1, 0);

	return;

}

